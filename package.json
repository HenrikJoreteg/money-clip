{
  "name": "money-clip",
  "description": "For managing your client side cache. Tiny wrapper over IndexedDB supporting versioning and max age.",
  "version": "4.0.0",
  "author": "Henrik Joreteg <henrik@joreteg.com> (joreteg.com)",
  "bugs": {
    "url": "https://github.com/HenrikJoreteg/money-clip/issues"
  },
  "dependencies": {
    "idb-keyval": "6.2.4"
  },
  "files": [
    "index.js"
  ],
  "type": "module",
  "homepage": "https://github.com/HenrikJoreteg/money-clip",
  "keywords": [
    "PWA",
    "cache",
    "indexeddb"
  ],
  "license": "MIT",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "jsxSingleQuote": true,
    "arrowParens": "avoid"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HenrikJoreteg/money-clip.git"
  },
  "scripts": {
    "ensure-no-unstaged": "git diff && git diff --quiet",
    "format": "prettier --write .",
    "test": "node --test"
  },
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
